{
  "id": "mesh-solidify",
  "name": "STL Mesh Studio",
  "version": "0.3.1",
  "description": "Native STL mesh operations: solidify, inspect, clean duplicate/degenerate faces, smooth vertices, reduce triangle count and offset the surface.",
  "capabilities": [
    "commands@0.1"
  ],
  "runtime": {
    "module": "mesh-solidify.wasm",
    "commands": [
      "face.delete",
      "mesh.convert",
      "model.mesh",
      "selection.get",
      "solid.move",
      "solid.press_pull",
      "solid.scale",
      "solid.split_body",
      "timeline.add"
    ],
    "limits": {
      "fuel": 100000000000,
      "memory_mib": 128,
      "deadline_ms": 30000
    },
    "entries": [
      {
        "name": "solidify",
        "effect": "edit",
        "slots": [
          {
            "kind": "menu",
            "name": "STL • Reparar e Solidificar…"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "default": "",
              "title": "Body",
              "description": "Mesh body to rebuild. Empty uses the selected body."
            },
            "scale": {
              "type": "number",
              "default": 0.1,
              "exclusiveMinimum": 0,
              "title": "Scale",
              "description": "Uniform scale for the result: 0.1 is 10%."
            },
            "voxel": {
              "type": "number",
              "default": 0,
              "minimum": 0,
              "title": "Detail (mm)",
              "description": "Grid spacing in output mm. 0 picks the finest that fits the voxel budget."
            },
            "min_feature": {
              "type": "number",
              "default": 0,
              "minimum": 0,
              "title": "Thicken (mm)",
              "description": "Offset the surface outward so thin parts survive slicing."
            },
            "iso": {
              "type": "number",
              "default": 0.5,
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1,
              "title": "Fill threshold",
              "description": "Winding-number threshold for inside. Lower fills more."
            },
            "target_faces": {
              "type": "integer",
              "default": 20000,
              "minimum": 100,
              "maximum": 30000,
              "title": "Triangles",
              "description": "Output triangle budget (SolidCraft 0.41 accepts about 30,000 from a plugin)."
            },
            "fair_tau": {
              "type": "number",
              "default": 0.5,
              "minimum": 0,
              "title": "Patch smoothing",
              "description": "Vertices farther than this many voxels from the input are hole patches and get smoothed. 0 turns it off."
            },
            "fair_grow": {
              "type": "integer",
              "default": 2,
              "minimum": 0,
              "maximum": 10,
              "title": "Smoothing rings",
              "description": "Extra rings smoothed around each patch."
            },
            "max_voxels": {
              "type": "integer",
              "default": 1500000,
              "minimum": 1000,
              "maximum": 2000000,
              "title": "Voxel budget",
              "description": "Largest grid when Detail is 0. More is finer but slower; SolidCraft 0.41 stops a plugin after a fixed amount of work, about 2,000,000 here."
            }
          }
        }
      },
      {
        "name": "inspect",
        "effect": "read",
        "slots": [
          {
            "kind": "menu",
            "name": "STL • Analisar Malha…"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "default": "",
              "title": "Body",
              "description": "Mesh body to check. Empty uses the selected body."
            },
            "scale": {
              "type": "number",
              "default": 1,
              "exclusiveMinimum": 0,
              "title": "Scale"
            }
          }
        }
      },
      {
        "name": "clean-mesh",
        "effect": "edit",
        "slots": [
          {
            "kind": "menu",
            "name": "STL • Limpar Malha"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "default": "",
              "title": "Body",
              "description": "Mesh to edit. Empty uses the selected body."
            },
            "area_epsilon": {
              "type": "number",
              "default": 1e-10,
              "minimum": 0,
              "title": "Minimum face area",
              "description": "Faces with area at or below this value are removed."
            }
          }
        }
      },
      {
        "name": "smooth-mesh",
        "effect": "edit",
        "slots": [
          {
            "kind": "menu",
            "name": "STL • Suavizar Malha"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "default": "",
              "title": "Body",
              "description": "Mesh to edit. Empty uses the selected body."
            },
            "iterations": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 100,
              "title": "Iterations"
            },
            "factor": {
              "type": "number",
              "default": 0.35,
              "exclusiveMinimum": 0,
              "maximum": 1,
              "title": "Smoothing strength"
            },
            "preserve_boundary": {
              "type": "boolean",
              "default": true,
              "title": "Preserve open edges"
            }
          }
        }
      },
      {
        "name": "decimate-mesh",
        "effect": "edit",
        "slots": [
          {
            "kind": "menu",
            "name": "STL • Reduzir Malha"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "default": "",
              "title": "Body",
              "description": "Mesh to edit. Empty uses the selected body."
            },
            "target_faces": {
              "type": "integer",
              "default": 1000,
              "minimum": 100,
              "title": "Target triangles"
            }
          }
        }
      },
      {
        "name": "offset-mesh",
        "effect": "edit",
        "slots": [
          {
            "kind": "menu",
            "name": "STL • Deslocar Superfície"
          }
        ],
        "input_schema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string",
              "default": "",
              "title": "Body",
              "description": "Mesh to edit. Empty uses the selected body."
            },
            "distance": {
              "type": "number",
              "default": 0.5,
              "title": "Offset distance (mm)",
              "description": "Positive moves along averaged vertex normals; negative moves inward."
            }
          }
        }
      }
    ]
  }
}
